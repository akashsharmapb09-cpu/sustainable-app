# Public Convex deployment URL (the .convex.cloud URL).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# For local development, use http://127.0.0.1:3210 after starting `pnpm exec convex dev`.

# Optional app metadata
VITE_APP_ENV=development
VITE_APP_URL=https://localhost:5175
VITE_ENABLE_MOCK_FALLBACK=true

# Configure these in Convex Dashboard > Environment Variables, never in VITE_ variables:
# AUTH_EMAIL=GreenSwap <no-reply@example.com>
# AUTH_RESEND_KEY=...
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
